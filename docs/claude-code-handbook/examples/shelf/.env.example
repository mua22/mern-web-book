# Copy to .env and fill in. Never commit the real .env file.
# Values here are placeholders, not secrets.

PORT=3000
SHELF_DATA=data.json

# key:owner[:role] pairs, comma separated. Generate a key with:  node -e "console.log(crypto.randomUUID())"
SHELF_KEYS=replace-me-1:ada:admin,replace-me-2:bob

RATE_LIMIT=120

# Optional AI features (leave empty to disable)
ANTHROPIC_API_KEY=

# Optional email (leave MAIL_URL empty to keep messages in memory)
MAIL_URL=
MAIL_API_KEY=
MAIL_FROM=
# Secret shared with your mail provider to sign inbound webhooks. Generate:  openssl rand -hex 32
EMAIL_WEBHOOK_SECRET=
